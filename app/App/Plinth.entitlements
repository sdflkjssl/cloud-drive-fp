<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The host app is sandboxed too. It does not have to be, but it shares an
	     App Group with the extension, and App Groups only exist inside the
	     sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- 🔴 Denied explicitly, for the same reason as the extension: a
	     development signing identity injects this into every configuration,
	     Release included. -->
	<key>com.apple.security.get-task-allow</key>
	<false/>

	<key>com.apple.security.network.client</key>
	<true/>

	<!-- 🔴 Must match the extension's group EXACTLY. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.quarkpan.plinth</string>
	</array>
</dict>
</plist>
